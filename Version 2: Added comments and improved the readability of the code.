        "\n",
        " #Creating a Modular Calculator Mini-Program\n",
        "\n",
        "#Asks users for the first number.\n",
        "def get_first_number():\n",
        "  return float(input(\"Enter the first number.\"))\n",
        "\n",
        "#Asks users for the second number.\n",
        "def get_second_number():\n",
        "  return float(input(\"Enter the second number.\"))\n",
        "\n",
        "#Function for addition.\n",
        "def add_numbers(num1, num2):\n",
        "  sum = num1 + num2\n",
        "  return sum\n",
        "\n",
        "#function for subtraction.\n",
        "def subtract_numbers(num1, num2):\n",
        "  difference = num1 - num2\n",
        "  return difference\n",
        "\n",
        "#function for multiplication.\n",
        "def multiply_numbers(num1, num2):\n",
        "  product = num1 * num2\n",
        "  return product\n",
        "\n",
        "#Function for division.\n",
        "def divide_numbers(num1, num2):\n",
        "  if num2 == 0:\n",
        "    print(\"Error, cannot be divided by 0\")\n",
        "  else:\n",
        "     quotient = num1 / num2\n",
        "     return quotient\n",
        "\n",
        "#Asks user to choose an operation.\n",
        "def get_operation():\n",
        "  print(\"Choose operation:\")\n",
        "  print(\"1 - Addition\")\n",
        "  print(\"2 - Subtraction\")\n",
        "  print(\"3 - Multiplication\")\n",
        "  print(\"4 - Division\")\n",
        "  choice = input(\"Enter your choice (1/2/3/4):\")\n",
        "  return choice\n",
        "\n",
        "#Executes the program and diplays the result.\n",
        "def main():\n",
        "  num1 = get_first_number()\n",
        "  num2 = get_second_number()\n",
        "  choice = get_operation()\n",
        "  if choice == '1':\n",
        "     sum = add_numbers(num1, num2)\n",
        "     print (f\"Result: {sum}\")\n",
        "  elif choice == '2':\n",
        "    difference = subtract_numbers(num1, num2)\n",
        "    print (f\"Result: {difference}\")\n",
        "  elif choice == '3':\n",
        "    product = multiply_numbers(num1, num2)\n",
        "    print (f\"Result: {product}\")\n",
        "  elif choice == '4':\n",
        "    quotient = divide_numbers(num1, num2)\n",
        "    print (f\"Result: {quotient}\")\n",
        "  else:\n",
        "   print(\"Invalid, please choose between 1,2,3,4.\")\n",
        "\n",
        "#Calls for the program to be exucuted.\n",
        "if __name__ == \"__main__\":\n",
        "  main()\n",
